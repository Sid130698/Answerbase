# Copy to .env.production at repository root, chmod 600. Never commit the real file.
POSTGRES_PASSWORD=replace-with-a-long-random-password
CUSTOMER_HOST=answerbase.example.com
SUPPORT_HOST=support.answerbase.example.com
ACME_EMAIL=operator@example.com
CUSTOMER_ORIGIN=https://answerbase.example.com
SUPPORT_ORIGIN=https://support.answerbase.example.com
VITE_SUPABASE_URL=https://PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=replace-with-publishable-key
SUPABASE_AUTH_ISSUER=https://PROJECT.supabase.co/auth/v1
SUPABASE_JWKS_URL=https://PROJECT.supabase.co/auth/v1/.well-known/jwks.json
DOCUMENT_STORAGE_URL=https://PROJECT.supabase.co
DOCUMENT_STORAGE_BUCKET=answerbase-documents
DOCUMENT_STORAGE_SERVICE_KEY=replace-with-server-only-secret
GENERATION_PROVIDER=groq
GENERATION_MODEL=llama-3.1-8b-instant
GENERATION_MODELS=llama-3.1-8b-instant
GROQ_API_KEY=replace-with-server-only-key
EMBEDDING_MODEL=nomic-embed-text:latest
RETRIEVAL_RERANK=true
DOCUMENT_MAX_VERSIONS=3000
DOCUMENT_MAX_BYTES=838860800
API_DOCS_ENABLED=false
WORKSPACE_MAX_PER_ORGANIZATION=50
DOCUMENT_TOTAL_MAX_BYTES=838860800
# Optional HTTPS endpoint controlled by your operators; alerts contain aggregate status only.
MONITOR_WEBHOOK_URL=
