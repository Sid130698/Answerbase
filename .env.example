# Local development only. Copy to .env; do not commit .env.
POSTGRES_DB=answerbase
POSTGRES_USER=answerbase
POSTGRES_PASSWORD=answerbase-local
POSTGRES_PORT=55432
API_PORT=8080
FRONTEND_PORT=5173
# Host-run Java apps can override these environment variables:
# DATABASE_URL=jdbc:postgresql://localhost:55432/answerbase
# DATABASE_USERNAME=answerbase
# DATABASE_PASSWORD=answerbase-local
# Supabase public browser configuration (never use a service-role/secret key).
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Usually https://<project-ref>.supabase.co/auth/v1
SUPABASE_AUTH_ISSUER=
# Optional internal URL for local Docker; hosted projects can leave empty.
SUPABASE_JWKS_URL=

# Expose API docs locally; set false to disable both spec and Swagger UI.
API_DOCS_ENABLED=true

# Originals: persistent Docker volume locally; private Supabase bucket when hosted.
DOCUMENT_STORAGE_PROVIDER=local
DOCUMENT_STORAGE_URL=
DOCUMENT_STORAGE_BUCKET=answerbase-documents
# Server-side Supabase service_role key only. Never expose via VITE_*.
DOCUMENT_STORAGE_SERVICE_KEY=

# Local models; use localhost when running Java directly.
OLLAMA_URL=http://host.docker.internal:11434
EMBEDDING_MODEL=nomic-embed-text:latest
RERANKER_URL=http://host.docker.internal:8092
RETRIEVAL_MODE=hybrid
RETRIEVAL_CANDIDATES=30
RETRIEVAL_TOP_K=6
RETRIEVAL_RERANK=false
GENERATION_PROVIDER=ollama
GENERATION_MODEL=llama3.1:8b
GENERATION_URL=https://api.groq.com/openai/v1
GROQ_API_KEY=

# Optional server-approved generation model choices; install models before enabling them.
GENERATION_MODELS=
